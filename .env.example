# Optional API keys. Names only, never commit values.
# Only keys listed here are read; a source needing one shows "needs a key" until it is set.
# The one key unlocks MalwareBazaar and URLhaus; without it their panels show "needs a key" and the rest still works.
ABUSECH_AUTH_KEY=
# User-Agent for the site visit (Visit the site, --visit); blank sends a current desktop Chrome string.
CASEFILE_VISIT_USER_AGENT=
